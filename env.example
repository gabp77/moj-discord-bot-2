# ===============================
# Discord Bot — zmienne środowiskowe
# ===============================
# Skopiuj ten plik do `.env` i uzupełnij wartości.
# NIGDY nie commituj pliku `.env` do repozytorium!

# Token bota pobrany z https://discord.com/developers/applications -> Twój bot -> Bot -> Reset Token
DISCORD_TOKEN=wklej_tutaj_token_bota

# (opcjonalne) ID serwera testowego — jeśli ustawione, slash commands pojawią się od razu tylko na tym serwerze.
# Puste = komendy globalne (synchronizacja do ~1 godziny).
GUILD_ID=

# (opcjonalne) ID kategorii (channel category), w której będą tworzone kanały ticketów.
# Jeśli puste, kanały będą tworzone w głównej liście kanałów serwera.
TICKETS_CATEGORY_ID=

# (opcjonalne) ID roli, która ma mieć dostęp do każdego ticketu (np. Support Team).
# Jeśli puste — dostęp mają tylko autor ticketu i administratorzy.
STAFF_ROLE_ID=

# (opcjonalne) ID kanału, na który wysyłane jest powitanie nowych członków.
# Można też ustawić komendą /set-welcome-channel.
WELCOME_CHANNEL_ID=
